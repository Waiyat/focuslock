{
  "expo": {
    "name": "FocusLock",
    "slug": "focuslock",
    "scheme": "focuslock",
    "version": "1.1.5",
    "orientation": "portrait",
    "icon": "./assets/focuslock-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#FFFFFF",
      "iosDisplayInForeground": true
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFFFFF",
          "sounds": [
            "./assets/notification_chime.wav"
          ]
        }
      ],
      "expo-web-browser"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.focuslock.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "instagram",
          "snssdk1233",
          "twitter",
          "fb",
          "snapchat",
          "reddit",
          "barcelona",
          "pinterest",
          "linkedin",
          "youtube",
          "nflx",
          "twitch",
          "spotify",
          "whatsapp",
          "tg",
          "discord",
          "fb-messenger",
          "googlechrome",
          "firefox",
          "brave"
        ]
      }
    },
    "android": {
      "package": "com.focuslock.app",
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "QUERY_ALL_PACKAGES",
        "PACKAGE_USAGE_STATS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "focuslock-app"
      }
    }
  }
}
