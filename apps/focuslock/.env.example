# Supabase — Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Backend API base URL
EXPO_PUBLIC_BACKEND_URL=https://your-backend.example.com

# --- Google OAuth (expo-auth-session ID-token flow) ---
# Create these in Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# - Web client    → used for the ID-token request (webClientId)
# - iOS client    → bundle id com.focuslock.app
# - Android client→ package com.focuslock.app + your release SHA-1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com
